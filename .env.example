# MongoDB Atlas connection string (mongodb+srv://...)
MONGO_URI=

# Secret used by Auth.js to sign/encrypt session cookies. Generate with:
#   openssl rand -base64 32
JWT_SECRET=

# GitHub OAuth App credentials (github.com -> Settings -> Developer settings -> OAuth Apps)
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
